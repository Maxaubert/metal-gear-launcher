{
  "name": "mgs-master-hub",
  "productName": "MGS Master Hub",
  "version": "0.4.2",
  "description": "Fullscreen launcher for the Metal Gear Solid Master Collection",
  "author": "Max",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:integration": "cross-env HUB_INTEGRATION=1 vitest run tests/integration",
    "e2e": "npm run build && playwright test",
    "shoot": "npm run build && node scripts/shoot.mjs",
    "fetch-tools": "pwsh -NoProfile -File scripts/fetch-tools.ps1",
    "dist": "npm run fetch-tools && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-log": "^5.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
